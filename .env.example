# Copy this file to .env before running Docker Compose. Do not commit .env.
#
# The values below are local-development examples. Services are bound to
# 127.0.0.1 by docker-compose.yml. Replace every value marked CHANGE-ME before
# exposing the stack outside your own machine.

# Public addresses used by the browser and by CORS. For a public deployment,
# use the final HTTPS origin (for example https://bepnha.example.com).
PUBLIC_SITE_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api
CORS_ALLOWED_ORIGIN=http://localhost
API_INTERNAL_URL=http://api:8080/api/v1
POSTGRES_DB=CulinaryBlogDb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_PORT=5432

# MinIO is built from this pinned official source release because public
# Docker Hub images are no longer available.
MINIO_RELEASE=RELEASE.2025-10-15T17-29-55Z
MINIO_ROOT_USER=change-me-minio-root-user
MINIO_ROOT_PASSWORD=change-me-minio-root-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_BASE_URL=http://localhost:9000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password
API_PORT=8080
WEB_PORT=80

# Required by the API. Use a unique, random value of at least 32 characters.
JWT_SECRET=change-me-with-a-unique-random-secret-of-at-least-32-characters
JWT_ISSUER=CulinaryBlog
JWT_AUDIENCE=CulinaryBlogFrontend

# Browser refresh credentials are HttpOnly cookies. Keep false for local HTTP;
# set true only after HTTPS is active on the final domain.
AUTH_COOKIES_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Google OAuth is optional. Leave it empty to hide Google login. When enabled,
# this must be the same web-client ID used by the frontend and Google Console.
GOOGLE_CLIENT_ID=

# SMTP is optional. Keep it disabled for a local demo. Do not use a personal
# mailbox password; use an app password or a transactional-email credential.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Bep Nha

# OpenTelemetry. The Docker stack sends traces and metrics to its collector by
# default. Set an HTTPS OTLP endpoint only when using an external collector.
OTLP_ENDPOINT=http://otel-collector:4317
# Optional comma-separated OTLP headers, for example:
# OTLP_HEADERS=Authorization=Bearer%20replace-with-provider-token
OTLP_HEADERS=

# Local Docker starts with a migrated, seeded demo database. Set both false in
# a deployed multi-instance environment after running migration/seed separately.
APPLY_MIGRATIONS_ON_STARTUP=true
SEED_DEMO_DATA_ON_STARTUP=true
