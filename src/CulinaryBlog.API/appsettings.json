{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "System": "Warning" } },
    "WriteTo": [
      { "Name": "Console", "Args": { "standardErrorFromLevel": "Warning" } },
      { "Name": "File", "Args": { "path": "logs/culinary-blog-.log", "rollingInterval": "Day" } }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=CulinaryBlogDb;Username=postgres;Password=postgres;SSL Mode=Prefer;Trust Server Certificate=true;",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "JwtSettings": {
    "Issuer": "CulinaryBlog",
    "Audience": "CulinaryBlogFrontend",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Bếp Nhà"
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  },
  "AuthCookies": {
    "Secure": false,
    "SameSite": "Lax"
  },
  "ReverseProxy": {
    "TrustForwardedHeaders": false
  },
  "DatabaseInitialization": {
    "ApplyMigrationsOnStartup": true,
    "SeedDemoDataOnStartup": true
  },
  "Minio": {
    "Enabled": false,
    "Endpoint": "http://localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "Bucket": "culinary-blog",
    "Region": "us-east-1",
    "PublicBaseUrl": "http://localhost:9000"
  },
  "OpenTelemetry": {
    "ServiceName": "culinary-blog-api",
    "OtlpEndpoint": "",
    "Headers": ""
  },
  "RateLimiting": {
    "DefaultPermitLimit": 200,
    "DefaultWindowMinutes": 1,
    "LoginPermitLimit": 5,
    "LoginWindowMinutes": 1,
    "RegistrationPermitLimit": 3,
    "RegistrationWindowMinutes": 1,
    "UploadPermitLimit": 10,
    "UploadWindowMinutes": 1
  }
}
