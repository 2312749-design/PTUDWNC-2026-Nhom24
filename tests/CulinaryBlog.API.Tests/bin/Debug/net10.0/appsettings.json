{
  "Logging": {
    "Serilog": {
      "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "System": "Warning" } },
      "WriteTo": [
        { "Name": "Console", "Args": { "standardErrorFromLevel": "Warning" } },
        { "Name": "File", "Args": { "path": "logs/culinary-blog-.log", "rollingInterval": "Day" } }
      ]
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=CulinaryBlogDb;Username=postgres;Password=postgres;SSL Mode=Prefer;Trust Server Certificate=true;",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "JwtSettings": {
    "Secret": "CulinaryBlogSuperSecretKeyForJwtAuthentication2026Here!",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Minio": {
    "Enabled": false,
    "Endpoint": "http://localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "Bucket": "culinary-blog",
    "Region": "us-east-1",
    "PublicBaseUrl": "http://localhost:9000"
  },
  "OpenTelemetry": {
    "ServiceName": "culinary-blog-api",
    "OtlpEndpoint": ""
  },
  "RateLimiting": {
    "DefaultPermitLimit": 200,
    "DefaultWindowMinutes": 1,
    "LoginPermitLimit": 5,
    "LoginWindowMinutes": 1,
    "RegistrationPermitLimit": 3,
    "RegistrationWindowMinutes": 1
  }
}